@model CertificationTracker.Models.Certification
@{
    ViewData["Title"] = "Edit Certification";
}
<h2>Edit Certification</h2>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="CertificationId" />
    <div class="form-group mb-2">
        <label asp-for="CertificationName"></label>
        <input asp-for="CertificationName" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="form-group mb-2">
        <label asp-for="ValidityMonths"></label>
        <input asp-for="ValidityMonths" class="form-control" type="number" />
    </div>

    <div class="form-group mb-2">
        <label>Upload New Image (optional)</label>
        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
    </div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="mb-2">
            <p>Current Image:</p>
            <img src="@Model.ImageUrl" style="max-height:150px;" />
        </div>
    }

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
