@{
    ViewData["Title"] = "Home";
}
<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="card-title">Welcome to CertificationTracker</h3>
                <p class="text-muted">Track employee certifications, upcoming expiries and manage assignments from a single dashboard.</p>
                <a class="btn btn-primary" asp-controller="Certifications" asp-action="Index">View Certifications</a>
                <a class="btn btn-outline-secondary ms-2" asp-controller="EmployeeCertifications" asp-action="Index">View Assignments</a>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-sm-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Employees</h5>
                        <p class="card-text text-muted">Manage employee records and profiles.</p>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Employees" asp-action="Index">Open</a>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Notifications</h5>
                        <p class="card-text text-muted">Certifications with expiring assignments appear here.</p>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Notifications" asp-action="Index">Open</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Quick Links</h6>
                <ul class="list-unstyled">
                    <li><a asp-controller="Certifications" asp-action="Create">Create Certification</a></li>
                    <li><a asp-controller="Employees" asp-action="Create">Create Employee</a></li>
                    <li><a asp-controller="EmployeeCertifications" asp-action="Create">Assign Certification</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
