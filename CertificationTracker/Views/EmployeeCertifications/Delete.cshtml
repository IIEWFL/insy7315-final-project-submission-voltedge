@model CertificationTracker.Models.EmployeeCertification
<h2>Delete Assignment</h2>
<p>Are you sure you want to delete the certification assignment of <strong>@Model.Certification?.CertificationName</strong> for <strong>@Model.Employee?.FullName</strong>?</p>
<form asp-action="Delete">
    <input type="hidden" asp-for="EmployeeCertificationId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>